{
  "name": "pickwright",
  "version": "0.4.0",
  "description": "Chrome extension to pick page elements and generate Playwright-friendly locators",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "build:chrome": "cross-env TARGET=chrome OUT_DIR=dist webpack --mode production",
    "build:firefox": "cross-env TARGET=firefox OUT_DIR=dist-firefox webpack --mode production",
    "set-version": "node scripts/set-version.js",
    "dev": "webpack --mode development --watch",
    "lint": "eslint src/ --ext .ts,.tsx",
    "format": "prettier --write \"{src,tests}/**/*.{ts,tsx,css,html}\" \"playwright.config.ts\"",
    "test": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "copy-webpack-plugin": "^12.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.0.0",
    "eslint": "^8.57.0",
    "html-webpack-plugin": "^5.6.0",
    "mini-css-extract-plugin": "^2.9.0",
    "prettier": "^3.3.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.5.0",
    "web-ext": "^8.3.0",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/mulish": "^5.2.8",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  }
}
