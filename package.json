{
  "name": "pickwright",
  "version": "1.1.0",
  "description": "Chrome extension to pick page elements and generate Playwright-friendly locators",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "build:chrome": "cross-env TARGET=chrome OUT_DIR=dist webpack --mode production",
    "build:firefox": "cross-env TARGET=firefox OUT_DIR=dist-firefox webpack --mode production",
    "set-version": "node scripts/set-version.js",
    "dev": "webpack --mode development --watch",
    "lint": "eslint src/ --ext .ts,.tsx",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "format": "prettier --write \"{src,tests}/**/*.{ts,tsx,css,html}\" \"playwright.config.ts\"",
    "format:check": "prettier --check \"{src,tests}/**/*.{ts,tsx,css,html}\" \"playwright.config.ts\"",
    "test:scripts": "node --test scripts/set-version.test.js",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:scripts",
    "test": "npm run build && playwright test --project=chromium",
    "test:engine": "cross-env TEST_HARNESS=1 webpack --mode production && playwright test --project=engine"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.2.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.0.0",
    "eslint": "^8.57.0",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.9.0",
    "prettier": "^3.9.6",
    "ts-loader": "^9.6.2",
    "typescript": "^5.5.0",
    "web-ext": "^10.4.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/mulish": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
