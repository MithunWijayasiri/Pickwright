---
interface Props {
  // Unique per instance: the Firefox gradient id must not repeat on the page.
  id: string;
}
const { id } = Astro.props;
const gradient = `ff-grad-${id}`;
---

<div class="badges">
  <a
    class="badge"
    href="https://chromewebstore.google.com/detail/pickwright-playwright-loc/kgikopoehffaodbicnhajokkmhgjofjo"
    target="_blank"
    rel="noopener"
  >
    <svg width="26" height="26" viewBox="0 0 48 48" aria-hidden="true">
      <path d="M24 24 L3.22 12 A24 24 0 0 1 44.78 12 Z" fill="#EA4335"></path>
      <path d="M24 24 L44.78 12 A24 24 0 0 1 24 48 Z" fill="#FBBC05"></path>
      <path d="M24 24 L24 48 A24 24 0 0 1 3.22 12 Z" fill="#34A853"></path>
      <circle cx="24" cy="24" r="11.5" fill="#fff"></circle>
      <circle cx="24" cy="24" r="8.5" fill="#4285F4"></circle>
    </svg>
    <span class="txt">
      <span class="kicker">Available on the</span>
      <span class="store">Chrome Web Store</span>
    </span>
  </a>
  <a class="badge" href="https://addons.mozilla.org/en-US/firefox/addon/pickwright/" target="_blank" rel="noopener">
    <svg width="26" height="26" viewBox="0 0 48 48" aria-hidden="true">
      <defs>
        <radialGradient id={gradient} cx="35%" cy="72%" r="80%">
          <stop offset="0%" stop-color="#ffe14f"></stop>
          <stop offset="32%" stop-color="#ff980e"></stop>
          <stop offset="63%" stop-color="#ff3647"></stop>
          <stop offset="100%" stop-color="#9059ff"></stop>
        </radialGradient>
      </defs>
      <circle cx="24" cy="24" r="23" fill={`url(#${gradient})`}></circle>
      <path
        d="M24 7c5 3 7 7 6.5 11.5 2-1.5 4.5-1 6 1.5-1 8.5-6 15-12.5 15S11 28.5 12 20c2.5 3 5.5 3 7.5 1-1.5-6 1-11 4.5-14z"
        fill="#fff"
        opacity="0.24"></path>
    </svg>
    <span class="txt">
      <span class="kicker">Available on</span>
      <span class="store">Firefox Add-ons</span>
    </span>
  </a>
</div>

<style>
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    min-height: 56px;
    padding: 10px 20px 10px 16px;
    background: var(--bg3);
    border: 1px solid var(--border2);
    border-radius: var(--radius);
    transition: border-color 0.15s;
  }

  .badge:hover {
    border-color: var(--accent);
  }

  .txt {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .kicker {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }

  .store {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
</style>
