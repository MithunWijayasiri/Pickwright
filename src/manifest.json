{
  "manifest_version": 3,
  "name": "Pickwright",
  "version": "0.1.0",
  "description": "Pick page elements and generate Playwright-friendly locators",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
